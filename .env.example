# Application runtime
NODE_ENV=
HOST=
PORT=
# Public origin for password-reset / checkout return links (no trailing slash)
APP_BASE_URL=
# NEXT_PUBLIC_APP_URL=

# Legal / support (public). Operator display name — do not claim "registered company".
# NEXT_PUBLIC_LEGAL_COMPANY_NAME=DRVO TECH
# Optional support inbox; omit to hide email on /privacy and /terms
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Transactional email (EXTERNAL_GATE_EMAIL_PROVIDER)
# EMAIL_PROVIDER=local|dev|smtp|resend
# EMAIL_FROM=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=

# Payments (EXTERNAL_GATE_PAYMENT_PROVIDER) — leave unset/unconfigured until merchant ready
# PAYMENT_PROVIDER=

# Manual InstaPay billing (V1) — display-only; no payment API
# MANUAL_INSTAPAY_ENABLED=1
# INSTAPAY_PAYMENT_DISPLAY_NAME=
# INSTAPAY_PAYMENT_HANDLE=
# INSTAPAY_PAYMENT_INSTRUCTIONS=

# DRVO Tech central finance read-only integration (server only, disabled when unset)
# Generate a cryptographically random 32+ character secret; configure identical
# value in DRVO Tech's secret store. Never expose as NEXT_PUBLIC_*.
# DRVO_GROUP_FINANCE_EXPORT_TOKEN=

# SaaS Financial Hub: all controls remain off until reviewed activation.
# DRVO_SAAS_FINANCIAL_ENDPOINT=https://hub.example.com/api/saas-financial/v1/events
# DRVO_SAAS_FINANCIAL_SOURCE_KEY=
# DRVO_SAAS_FINANCIAL_SOURCE_STATUS=disabled
# DRVO_SAAS_FINANCIAL_SOURCE_ACTIVATED_AT=
# DRVO_SAAS_FINANCIAL_CAPTURE_CUTOFF_AT=
# DRVO_SAAS_FINANCIAL_CAPTURE_ENABLED=0
# DRVO_SAAS_FINANCIAL_DELIVERY_ENABLED=0
# DRVO_SAAS_FINANCIAL_RECONCILIATION_ENABLED=0
# DRVO_SAAS_FINANCIAL_CREDENTIAL_KEY_ID=
# DRVO_SAAS_FINANCIAL_CREDENTIAL_SECRET_REF=env:DEDICATED_HUB_SECRET
# Optional half-open Hub acceptance window; set both or neither. Omit for full audit.
# DRVO_SAAS_FINANCIAL_RECONCILIATION_ACCEPTED_FROM=
# DRVO_SAAS_FINANCIAL_RECONCILIATION_ACCEPTED_BEFORE=

# SQL Server (DB_NAME=DRVOWA in production; never commit secrets)
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=

# WhatsApp multi-account runtime (Phase 2B/3A) — server only
# Used for SaaS→runtime control and runtime→SaaS inbound ingest (Bearer).
WHATSAPP_RUNTIME_BASE_URL=
DRVOWA_RUNTIME_TOKEN=

# Gemini AI receptionist (Phase 3B) — server only; never commit secrets
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional dedicated model for knowledge ingestion (falls back to GEMINI_MODEL)
# GEMINI_KNOWLEDGE_MODEL=
# AI_WORKER_CONCURRENCY=2
# AI_WORKER_POLL_MS=250


# External ERP integrations (server only)
# Long random secret used to encrypt per-tenant connector credentials at rest.
INTEGRATION_SECRET_KEY=
