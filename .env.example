# Application runtime
NODE_ENV=
HOST=
PORT=
# Public origin for password-reset links (no trailing slash), e.g. https://app.example.com
APP_BASE_URL=
# NEXT_PUBLIC_APP_URL=

# Transactional email (EXTERNAL_GATE_EMAIL_PROVIDER). unset/gated in production until configured.
# EMAIL_PROVIDER=local|dev|smtp|resend|ses

# SQL Server (DB_NAME=DRVOWA in production; never commit secrets)
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=

# WhatsApp multi-account runtime (Phase 2B/3A) — server only
# Used for SaaS→runtime control and runtime→SaaS inbound ingest (Bearer).
WHATSAPP_RUNTIME_BASE_URL=
DRVOWA_RUNTIME_TOKEN=

# Gemini AI receptionist (Phase 3B) — server only; never commit secrets
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_WORKER_CONCURRENCY=2
# AI_WORKER_POLL_MS=250
